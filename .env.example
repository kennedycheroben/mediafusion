# ==============================================================================
# MEDIAFUSION — SECURE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit the real .env file or put production secrets in version control.
# 2. Keep server-side secrets away from browser-accessible code.
# 3. In production, ensure ENCRYPTION_KEY is a 64-character hex string (32 bytes).
#    NEVER overwrite an existing ENCRYPTION_KEY on an active database containing
#    encrypted OAuth tokens.
# ==============================================================================

# ==========================================
# 1. APPLICATION & ENVIRONMENT
# ==========================================
# Set APP_ENV=production and APP_URL=https://fusionmedia.top on live server
APP_ENV=local
APP_URL=https://fusionmedia.top
APP_DEBUG=false
MEDIAFUSION_FORCE_PRODUCTION=0
TRUST_PROXY_HEADERS=false

# Session Security Policies (in seconds)
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
SESSION_REGEN_INTERVAL=300

# ==========================================
# 2. DATABASE CONFIGURATION
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mediafusion
DB_USER=root
DB_PASS=

# ==========================================
# 3. TOKEN ENCRYPTION & SECURITY
# ==========================================
# Master key for AES-256-GCM encryption of stored OAuth access & refresh tokens.
# Required format: 64-character hex string (32 bytes).
# Generate via CLI: php -r "echo bin2hex(random_bytes(32));"
# WARNING: NEVER replace this key if your database already contains encrypted tokens!
ENCRYPTION_KEY=replace_with_64_character_hex_string_32_bytes

# ==========================================
# 4. GOOGLE & YOUTUBE INTEGRATIONS
# ==========================================
# Obtained from: Google Cloud Console -> APIs & Services -> Credentials
# Production Redirect URI: https://fusionmedia.top/backend/google_auth.php
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/mediafusion/backend/google_auth.php

# YouTube Data API v3 Upload Credentials
# Production Redirect URI: https://fusionmedia.top/callback.php
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
MEDIAFUSION_OAUTH_REDIRECT_URI=http://localhost/mediafusion/callback.php

# ==========================================
# 5. TIKTOK INTEGRATION
# ==========================================
# Obtained from: TikTok Developer Portal -> My Apps -> App Settings
# Production Redirect URI: https://fusionmedia.top/callback.php
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost/mediafusion/callback.php

# ==========================================
# 6. META / FACEBOOK / INSTAGRAM INTEGRATION
# ==========================================
# Obtained from: Meta for Developers -> App Settings -> Basic & Facebook Login
# Production Redirect URI: https://fusionmedia.top/callback_meta.php
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_CONFIG_ID=your_meta_config_id
META_REDIRECT_URI=http://localhost/mediafusion/callback_meta.php
META_GRAPH_VERSION=v25.0

# ==========================================
# 7. CLOUDFLARE R2 / S3-COMPATIBLE STORAGE
# ==========================================
# Set S3_ENABLED=true to enable object storage offloading for video assets
S3_ENABLED=false
S3_BUCKET=mediafusion-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_or_r2_access_key
S3_SECRET_KEY=your_s3_or_r2_secret_key
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
S3_PUBLIC_URL_TEMPLATE=https://your-custom-domain.com/{key}
S3_PATH_STYLE=false
CDN_BASE_URL=https://your-cdn-domain.com

# ==========================================
# 8. SMTP EMAIL CONFIGURATION
# ==========================================
# Used for password reset notifications and system alerts
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_ENCRYPTION=ssl

# ==========================================
# 9. SPEECH-TO-TEXT (STT) & AI INTEGRATIONS
# ==========================================
# Obtained from: OpenAI Platform -> API Keys
# Required for auto-captions and audio transcription (Whisper API)
OPENAI_API_KEY=your_openai_api_key

# ==========================================
# 10. BACKGROUND REMOVAL PROVIDERS
# ==========================================
# Configure at least one provider for MediaFusion Studio AI Cutout feature
REMOVE_BG_API_KEY=your_remove_bg_api_key
CLIPDROP_API_KEY=your_clipdrop_api_key
PHOTOROOM_API_KEY=your_photoroom_api_key
